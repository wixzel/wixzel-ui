{
  "name": "wixzel-ui",
  "version": "0.1.0",
  "description": "Wixzel UI for React: calm, tonal, crafted components, and a whole palette from one seed colour.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "bin": {
    "wixzel-ui": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "icons": "node scripts/icons.ts",
    "build": "rm -rf dist && node scripts/icons.ts && tsup && node scripts/bundle-types.ts",
    "dev": "node scripts/icons.ts && tsup --watch",
    "typecheck": "node scripts/icons.ts && tsc --noEmit -p ."
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4.1"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wixzel/tokens": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3"
  },
  "license": "MIT",
  "homepage": "https://ui.wixzel.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wixzel/wixzel-ui.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/wixzel/wixzel-ui/issues",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "design-tokens",
    "tailwindcss",
    "radix",
    "oklch",
    "wixzel"
  ]
}
